APP_NAME=SpeechFlow API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

FRONTEND_URL=http://localhost:3000

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8



# Streaming configuration

STREAM_MIN_AUDIO_SECONDS=3.0
STREAM_UPDATE_INTERVAL_SECONDS=2.0
STREAM_MAX_DURATION_SECONDS=60
STREAM_IDLE_TIMEOUT_SECONDS=30